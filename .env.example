# Copy this file to .env and fill it in. Never commit .env.
# Variables already set in the environment (e.g. by your hosting platform) take precedence over this file.

# --- LLM (required) ---
GROQ_API_KEY=
# Leave empty for the default, openai/gpt-oss-120b
LLM_MODEL=
# Used while the main model is rate limited; empty for the default (openai/gpt-oss-20b), or "none" to disable
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0
# gpt-oss reasoning: low (default: fast, fewer tokens), medium or high; "none" for models without it
LLM_REASONING_EFFORT=low

# --- Authentication (required) ---
# Signs login tokens; at least 32 characters. The server refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# SQLite file holding user accounts
AUTH_DB=auth.db

# --- Server ---
# Browser origins allowed to call the API (comma-separated): where the React app is served from
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLite file where sessions are saved, so they survive a backend restart
SESSION_DB=sessions.db
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Run button ---
# Slack steps post to this incoming webhook (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=
